{
  "name": "forge-client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "TMPDIR=\"$PWD/node_modules/.vitest-tmp\" vitest run; rc=$?; rm -rf node_modules/.vitest-tmp; exit $rc",
    "mutate": "TMPDIR=\"$PWD/node_modules/.vitest-tmp\" stryker run; rc=$?; rm -rf node_modules/.vitest-tmp; exit $rc",
    "typecheck": "tsc --noEmit",
    "typecheck:markup": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^10.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^15.15.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@cmshiki/shiki": "^0.2.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@git-diff-view/svelte": "^0.1.7",
    "@tauri-apps/api": "^2.12.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "pdfjs-dist": "^6.4.299",
    "shiki": "^3.23.0",
    "virtua": "^0.52.9"
  }
