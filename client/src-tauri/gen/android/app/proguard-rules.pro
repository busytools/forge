# Add project specific ProGuard rules here.
# You can control the set of applied configuration files using the
# proguardFiles setting in build.gradle.
#
# For more details, see
#   http://developer.android.com/guide/developing/tools/proguard.html

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# Uncomment this to preserve the line number information for
# debugging stack traces.
#-keepattributes SourceFile,LineNumberTable

# If you keep the line number information, uncomment this to
# hide the original source file name.
#-renamesourcefileattribute SourceFile

# The plugin `@Command` argument classes are bound by Jackson through
# reflection in `Invoke.parseArgs`: R8 cannot see the no-arg constructor or the
# fields used, so the release build stripped them and every command that parses
# arguments failed before it ran (vault enrolment: "Cannot construct instance
# of dev.vedhavyas.forge.StoreArgs (no Creators)"). Tauri's consumer rules keep
# `@InvokeArg`-annotated classes; this rule keeps every argument class in this
# package with or without the annotation, so a plugin that forgets the marker
# cannot reintroduce the defect. `proguard-tauri.pro` is generated by Tauri's
# build script and gitignored, which is why the rule lives here.
-keep class dev.vedhavyas.forge.*Args { *; }
