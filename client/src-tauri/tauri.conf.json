{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "forge",
  "identifier": "dev.vedhavyas.forge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "forge",
        "width": 1440,
        "height": 900
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "android": {
      "minSdkVersion": 26
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["browser-stack/**/*"],
    "macOS": {
      "files": {
        "Frameworks/Chromium Embedded Framework.framework": "cef-bundle/Chromium Embedded Framework.framework",
        "Frameworks/forge-client Helper.app": "cef-bundle/forge-client Helper.app",
        "Frameworks/forge-client Helper (Alerts).app": "cef-bundle/forge-client Helper (Alerts).app",
        "Frameworks/forge-client Helper (GPU).app": "cef-bundle/forge-client Helper (GPU).app",
        "Frameworks/forge-client Helper (Plugin).app": "cef-bundle/forge-client Helper (Plugin).app",
        "Frameworks/forge-client Helper (Renderer).app": "cef-bundle/forge-client Helper (Renderer).app"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0ODY3NTNBRUYzNkU2NzAKUldSdzVqYnZPbldHUk5LdVA5M2ZSRDJDNzhGWWltMDFGZkl1N2ZhWTRtb2c5L3UzMTEvdUNacWkK",
      "endpoints": ["https://github.com/busytools/forge/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
