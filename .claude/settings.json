{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git push origin main)",
      "Bash(git push origin v*)",
      "Bash(git push origin --delete *)",
      "Bash(git merge --ff-only *)",
      "Bash(git branch -d *)",
      "Bash(gh run watch *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ]
  }
}
